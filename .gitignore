# ─── User configuration (contains local paths and usernames — never commit) ────
config.yml

# ─── Environment / secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Editor and IDE files ─────────────────────────────────────────────────────
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# ─── OS-generated files ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Debug and log files ──────────────────────────────────────────────────────
gphoto2-debug.log
*.log

# ─── Temporary / build artifacts ──────────────────────────────────────────────
*.tmp
*.bak
*.orig
/tmp/

# ─── State files (written at runtime to the photo destination) ────────────────
.last_sync_count

# ─── Local assistant / tooling scaffolding ────────────────────────────────────
# graphify knowledge-graph artefacts and Claude Code config are per-machine
# tooling: regenerable, machine-specific, and unrelated to the sync script.
# They stay on disk and keep working locally — they are just not shared.
.claude/
CLAUDE.md
graphify-out/
.graphifyignore
.gitattributes
