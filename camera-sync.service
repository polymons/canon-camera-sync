# systemd service: Runs the camera sync script when triggered by udev.
#
# This service runs as root (no User=/Group= set) because gphoto2 needs
# root privileges to send USBDEVFS_DISCONNECT and detach the kernel USB driver.
# File ownership is set to the configured user via chown in the script.
#
# NOTE: This file is the TEMPLATE install.sh installs from. The placeholder
#       markers below are substituted with validated values from config.yml.
#       Every other line is installed verbatim, so this file — not install.sh —
#       is where the hardening set lives.
#       To change values, edit config.yml and re-run: sudo ./install.sh

[Unit]
Description=Canon Camera Photo Sync
After=local-fs.target

[Service]
Type=oneshot
ExecStartPre=/bin/sleep @PRE_DELAY@
ExecStart=@SCRIPT_DIR@/camera-sync.sh
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=@DEST_BASE@
# ProtectSystem=strict makes all of /run read-only, which would silently disable
# the script's flock. RuntimeDirectory= carves out a writable
# /run/canon-camera-sync — the lock path camera-sync.sh prefers.
RuntimeDirectory=canon-camera-sync
# Keep the directory when the unit stops: the Wi-Fi unit locks in the same
# place, and tearing it down mid-run would hand the two runs different
# inodes for the same path — i.e. no mutual exclusion at all.
RuntimeDirectoryPreserve=yes
# Prometheus metrics for the Grafana dashboard. The leading '-' marks the path
# optional: without it a missing directory makes the unit fail to start, whereas
# here it is skipped and the script's writability probe turns metrics off.
ReadWritePaths=-@METRICS_DIR@
